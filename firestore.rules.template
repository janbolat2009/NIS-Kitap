rules_version = '2';

// NIS Kitap — Firestore Security Rules.
// Source: firestore.rules.template. Run `npm run rules:build` to produce firestore.rules.
// Role lists come from config/access.json; permissions from src/lib/permissions.js.
//
// Since API v2 every write that needs trust (points, stock, reservations, reading
// verification, classes, rewards, reviews, roles, settings) is done by the server
// (api/v2) with the Admin SDK, which is not subject to these rules. Browsers get
// read access to their own data and to public data, and may write only their
// bookmarks, their basic account fields and their own analytics events.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity ----------
    function signedIn() { return request.auth != null; }
    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function owner() { return signedIn() && resource.data.uid == request.auth.uid; }

    function rolePath() { return /databases/$(database)/documents/roles/$(myEmail()); }
    function storedRole() {
      return exists(rolePath()) && get(rolePath()).data.role in __ASSIGNABLE_ROLES__
        ? get(rolePath()).data.role : 'student';
    }

    function role() {
      return !verified() ? 'none'
        : myEmail() in __TECH_ADMIN_EMAILS__ ? 'tech_admin'
        : myEmail() in __DIRECTOR_EMAILS__ ? 'director'
        : myEmail() in __DEPUTY_EMAILS__ ? 'deputy'
        : myEmail() in __LIBRARIAN_EMAILS__ ? 'librarian'
        : storedRole();
    }
    function hasAny(roles) { return verified() && role() in roles; }

__PERMISSION_FUNCTIONS__

    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }

    // ---------- account ----------
    // Basic account fields only; class, shanyrak and role live elsewhere.
    match /users/{uid} {
      allow read: if isMe(uid) || can_students_view();
      allow create, update: if isMe(uid)
        && onlyKeys(['name', 'email', 'avatar', 'provider', 'lastLogin', 'createdAt', 'updatedAt'])
        && (!('email' in request.resource.data) || request.resource.data.email.lower() == myEmail())
        && request.resource.data.get('name', '').size() <= 120
        && request.resource.data.get('avatar', '').size() <= 500;
      allow delete: if false;
    }

    // Profile with class and shanyrak: written only by the server.
    match /profiles/{uid} {
      allow read: if isMe(uid) || can_students_view();
      allow write: if false;
    }
    match /class_history/{id} {
      allow read: if owner() || can_students_view();
      allow write: if false;
    }
    match /roles/{email} {
      allow read: if (verified() && email == myEmail()) || can_roles_manage();
      allow write: if false;
    }

    // ---------- school structure (public) ----------
    match /class_map/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /shanyraks/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{doc} {
      allow read: if doc in ['school', 'points'] || can_settings_manage();
      allow write: if false;
    }
    match /settings_history/{id} {
      allow read: if can_settings_manage() || can_audit_view();
      allow write: if false;
    }
    // Roster imported by staff (old version); read by the server.
    match /students/{email} {
      allow read: if (verified() && email == myEmail()) || can_students_view();
      allow write: if false;
    }
    match /memberships/{id} {
      allow read: if can_students_view();
      allow write: if false;
    }

    // ---------- reading ----------
    match /reading_progress/{id} {
      allow read: if owner() || can_reading_verify() || can_students_view();
      allow write: if false;
    }
    match /reading_events/{id} {
      allow read: if owner() || can_reports_view();
      // A reader may log their own page views and bookmarks for statistics.
      allow create: if verified()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['view', 'bookmark', 'unbookmark']
        && request.resource.data.keys().hasOnly(['uid', 'type', 'source', 'occurredAt', 'metadata', 'bookId', 'bookTitle', 'bookAuthor', 'language', 'genre', 'isHundred', 'hundredId']);
      allow update, delete: if false;
    }
    match /bookmarks/{id} {
      allow read: if signedIn() && id.matches(request.auth.uid + '__.*');
      allow create, update: if verified()
        && id.matches(request.auth.uid + '__.*')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'bookId', 'bookTitle', 'bookAuthor', 'language', 'genre', 'isHundred', 'hundredId', 'createdAt']);
      allow delete: if signedIn() && id.matches(request.auth.uid + '__.*');
    }
    match /reviews/{id} {
      allow read: if resource.data.status == 'published' || owner() || can_reviews_moderate();
      allow write: if false;
    }

    // ---------- fund & reservations ----------
    match /inventory/{bookId} {
      allow read: if true;
      allow write: if false;
    }
    match /inventory_log/{id} {
      allow read: if can_fund_manage() || can_loans_manage();
      allow write: if false;
    }
    match /book_stock/{bookId} {
      allow read: if true;
      allow write: if false;
    }
    match /reservations/{id} {
      allow read: if owner() || can_loans_manage() || can_students_view();
      allow write: if false;
    }
    match /mail_log/{id} {
      allow read: if can_notifications_send() || can_settings_manage();
      allow write: if false;
    }

    // ---------- points ----------
    match /points_ledger/{id} {
      allow read: if owner() || can_points_view_all();
      allow write: if false;
    }
    match /student_points/{uid} {
      allow read: if isMe(uid) || can_points_view_all();
      allow write: if false;
    }
    // Short public rows («Имя Ф., 10A»), only for signed-in readers.
    match /leaderboard/{uid} {
      allow read: if verified();
      allow write: if false;
    }
    // Shanyrak totals by month, kind and class — no personal data.
    match /shanyrak_points/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- rewards ----------
    match /rewards/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /reward_issues/{id} {
      allow read: if owner() || can_rewards_manage() || can_rewards_issue() || can_rewards_approve();
      allow write: if false;
    }
    match /certificates/{number} {
      allow get: if true;
      allow list: if can_rewards_manage();
      allow write: if false;
    }

    // ---------- audit ----------
    match /admin_audit_logs/{id} {
      allow read: if can_audit_view();
      allow write: if false;
    }

    // Everything else (rate_limits, reservation_locks, migration_*) is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
