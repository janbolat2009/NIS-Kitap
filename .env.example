# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values. See docs/ADMIN_GUIDE.md.

# Server access to Firestore/Auth for api/v2 (service-account JSON, raw or base64)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=nis-kitap-2025

# Pickup e-mails: the official library mailbox (the sender is always SMTP_USER
# unless MAIL_FROM is set and MAIL_FROM_VERIFIED=true)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Библиотека NIS Kitap
MAIL_FROM=
MAIL_FROM_VERIFIED=false
MAIL_REPLY_TO=

# Daily expiry of reservations (Vercel Cron sends it as a Bearer token)
CRON_SECRET=

# Optional
SITE_URL=https://www.niskitap.site
ALLOWED_ORIGINS=

# Gemini AI search (server-side only)
GEMINI_API_KEY=

# Local emulators (see .env.emulator, never in production)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
