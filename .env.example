# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Gemini AI search (server-side only, used by api/gemini/search.js)
GEMINI_API_KEY=

# Firebase project used to verify ID tokens in /api functions (public project id)
FIREBASE_PROJECT_ID=nis-kitap-2025

# Reservation email notifications (api/reservations)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: OpenAI key for the legacy local server (server/routes/openai.js). Server-side only.
OPENAI_API_KEY=

# Local Express server only (server/)
MONGODB_URI=
PORT=3001
